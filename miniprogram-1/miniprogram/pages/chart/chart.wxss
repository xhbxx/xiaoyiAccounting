.top {
  height: 200rpx;
  background: linear-gradient(to bottom,
      #f4c313fa 0%, #f4c313fa 100%, rgba(255, 183, 77, 0) 100%);
  box-sizing: content-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap:20rpx;
}

.title {

  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: baseline;
  gap: 20rpx;
}

.titleText {
  margin-top: 40rpx;
  font-size: 50rpx;
}
.Time{
  height:60rpx;
  width:700rpx;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: baseline;
}
.time{
  height: 100%;
  width:30%;
  border:1rpx solid #000000; 
  box-sizing:border-box;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.time.active {
  background-color: #222222dc; 
  color:#f4c313fa
}

.down {
  font-size: 35rpx;
}