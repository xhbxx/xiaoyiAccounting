  <!-- 标题 -->
<view class="top" style="padding-top:10px">
  <view class="Title">
    <text class="title {{currentType==='expense'?'active':''}}" bindtap="switchType" data-type="expense">支出</text>
    <text class="title {{currentType==='income'?'active':''}}" bindtap="switchType" data-type="income">收入</text>
    <view class="underline {{currentType}}"></view>
  </view>
</view>
  <!-- 第一页：支出分类 -->
<swiper class="swiper" current="{{currentTab}}" bindchange="onSwiperChange" duration="300">
  <swiper-item>
    <view class="Totleicon">
      <view class="icon" bindtap="selected" wx:for="{{itemE}}" wx:key="id" data-id="{{item.id}}" data-name="{{item.name}}">
        <image class="iconImage" src="/images/{{item.name}}1.png"></image>
        <text class="iconText">{{item.name}}</text>
      </view>
    </view>
   
  </swiper-item>
<!-- 第二页：收入分类 -->
  <swiper-item>
    <view class="Totleicon">
      <view class="icon" bindtap="selected" wx:for="{{itemI}}" wx:key="id" data-id="{{item.id}}" data-name="{{item.name}}">
        <image class="iconImage {{selectedId==item.id?'selected':''}}" src="/images/{{item.name}}1.png"></image>
        <text class="iconText">{{item.name}}</text>
      </view>
    </view>
  </swiper-item>
</swiper>
<!-- 弹窗遮盖 -->
<view class="mask" wx:if="{{showPopup}}" bindtap="closePopup">
  <view class="popup" wx:if="{{showPopup}}" catchtap="none">
      <!-- 金额 -->
      <view class="Amount">{{amount}}</view>
      <view class="Amount" wx:if="{{amount==''}}">0.00</view>
      <!-- 备注 -->
      <view class="Remark">
        <text>备注</text>
        <input class="remarkInput" placeholder="写点备注..." value="{{remark}}" bindinput="onRemarkInput" />
      </view>
      <!-- 键盘 -->
      <view class="keyboard">
      <!-- 第一排 -->
      <view class="key" bindtap="onKeyTap" data-key="7">7</view>
      <view class="key" bindtap="onKeyTap" data-key="8">8</view>
      <view class="key" bindtap="onKeyTap" data-key="9">9</view>
      <picker class="extra" mode="date" value="{{date}}" bindchange="date">
        <view class="extraD">
          <image class="dateIcon" src="/images/日历.png" wx:if = "{{billDateText=='今天'||billDateText==''}}"></image>
        <view class="dateT">{{billDateText}} </view>
        </view>
    </picker>
      <!-- 第二排 -->
      <view class="key" bindtap="onKeyTap" data-key="4">4</view>
      <view class="key" bindtap="onKeyTap" data-key="5">5</view>
      <view class="key" bindtap="onKeyTap" data-key="6">6</view>
      <view class="extra" bindtap="plus">+</view>
      <!-- 第三排 -->
      <view class="key" bindtap="onKeyTap" data-key="1">1</view>
      <view class="key" bindtap="onKeyTap" data-key="2">2</view>
      <view class="key" bindtap="onKeyTap" data-key="3">3</view>
      <view class="extra" bindtap="reduce">-</view>
      <!-- 第四排 -->
      <view class="key" bindtap="onKeyTap" data-key=".">.</view>
      <view class="key" bindtap="onKeyTap" data-key="0">0</view>
      <view class="extra" bindtap="onKeyDelete"> 
      <image class="dateDelte" src="/images/删除.png"></image>
      </view>
      <view class="extraConfirm" bindtap="submitBill">完成</view>
    </view>
  </view>
</view>
