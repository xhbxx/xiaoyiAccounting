/* pages/bill/bill.wxss */

.top
{
  height: 200rpx;
  background:linear-gradient(to bottom,
  #f4c313fa 0%,#f4c313fa 100%,rgba(255, 183, 77, 0) 100%);
  box-sizing: content-box;
  display:flex;
  flex-direction: column;
  justify-content: center;

}

.Title{
  display:flex;
  flex-direction: row;
  justify-content: center;
  gap:60rpx;
  position: relative; 
}

.title{
  margin-top:60rpx;
  font-size:40rpx;
  color:black;
}
.underline{
  position:absolute;
  bottom:-45rpx;
  width:80rpx;
  left: 50%;  
  height:4rpx;
  background: #000;
  margin-left: -30rpx;  
  transition: transform 0.3s ease;
}
.underline.income{
  transform: translateX(60rpx);
}
.underline.expense{
  transform: translateX(-80rpx);
}
.Totleicon{
  bottom:-45rpx;
  display:flex;
  flex-wrap: wrap;
  flex-direction: row;
  justify-content: flex-start;
  margin:20rpx 30rpx 20rpx 120rpx;
  gap:100rpx;
}
.iconImage{
  height: 100rpx;
  width:100rpx;
}
.icon{
  display:flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.swiper{
  height: 1200rpx;
}
.iconImage.selected{
  background: #f4c313;
  border-radius: 50%;
}

.mask{
  position: fixed;
  background: rgba(0,0,0,0.5); 
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 100;
}
.popup{
  position:absolute;
  bottom:0;
  width: 100%;
  background: #fff;
  z-index: 101;
}
.Amount{
  display: flex;
  justify-content: flex-end;
  font-size: 50rpx;
}
.Remark{
  height:70rpx;
  background-color: rgb(238, 238, 238);
  display: flex;
  align-items:center ;
  font-size: 35rpx;
  gap:20rpx;
}
.keyboard{
  width: 750rpx;
  height: 500rpx;
  display: flex;
  flex-wrap:wrap;
  align-content: flex-start;
}
.key{
  width:25%;
  height: 115rpx;
  border:1rpx solid #eee; 
  box-sizing:border-box;
  display:flex; 
  align-items:center;
  justify-content:center;
 
}
.extra{
  width:25%;
  height: 115rpx;
  display:flex; 
  align-items:center;
  justify-content:center;
  border:1rpx solid #eee; 
  box-sizing:border-box;
}
.extraD{
  width:100%;
  height: 100%;
  display:flex; 
  align-items:center;
  justify-content:center;

}
.extraConfirm{
  width:25%;
  height: 115rpx;
  display:flex; 
  align-items:center;
  justify-content:center;
  background-color: #f4c313;
  border:1rpx solid #eee; 
  box-sizing:border-box;
}
.dateIcon{
  height: 50rpx;
  width: 50rpx;
  flex-shrink: 0;
}
.dateDelte{
  height: 60rpx;
  width: 60rpx;
}