/**app.wxss**/

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
} 



button {
  background: initial;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}


page {
  padding-top: 30rpx;
  box-sizing: border-box;
  color: #332d28;
  font-size: 28rpx;
  background: #f6f6f6;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.top, .discover-header, .profile-header {
  position: relative;
}

.top::before, .discover-header::before, .profile-header::before {
  content: '';
  position: absolute;
  top: -30rpx;
  left: 0;
  right: 0;
  height: 30rpx;
  background: #f4c313fa;
}

.empty-state {
  padding: 48rpx 32rpx;
  text-align: center;
  color: #71685f;
  line-height: 1.6;
}

.screen-body { padding: 24rpx 28rpx calc(200rpx + env(safe-area-inset-bottom)); }
.section-card { background: #fff; border-radius: 20rpx; padding: 0 28rpx; margin-bottom: 24rpx; }
.section-title { font-size: 32rpx; font-weight: 600; padding: 28rpx 0; }
.settings-row { min-height: 112rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; border-bottom: 1rpx solid #eee; }
.settings-row:last-child { border-bottom: none; }
.row-label { display: flex; align-items: center; gap: 22rpx; min-width: 0; }
.row-icon { width: 54rpx; height: 54rpx; border: 3rpx solid #5d4139; border-radius: 14rpx; background: #fff4bb; color: #5d4139; display: flex; align-items: center; justify-content: center; font-size: 26rpx; flex-shrink: 0; }
.chevron { font-size: 44rpx; color: #aaa; }
.muted { color: #71685f; font-size: 25rpx; }
.avatar { width: 112rpx; height: 112rpx; border-radius: 50%; flex-shrink: 0; border: 4rpx solid #fff; }
.avatar-placeholder { display: flex; align-items: center; justify-content: center; background: #fff5ce; color: #5d4139; font-size: 44rpx; }
.primary-button { background: #f4c313; color: #332d28; border-radius: 14rpx; font-size: 30rpx; margin: 24rpx 0; }
.text-button { color: #785b00; font-size: 28rpx; padding: 12rpx 0; margin: 0; }
.dialog-mask { position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 1200; display: flex; align-items: center; justify-content: center; }
.dialog-card { width: 610rpx; max-height: 80vh; box-sizing: border-box; overflow-y: auto; background: #fff; border-radius: 24rpx; padding: 32rpx; }
.form-input { min-height: 88rpx; border-bottom: 1rpx solid #ddd; margin: 20rpx 0; font-size: 32rpx; }
.dialog-actions { display: flex; justify-content: flex-end; gap: 32rpx; margin-top: 24rpx; }
