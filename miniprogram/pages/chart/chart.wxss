.top {
  height: 200rpx;
  background-image: linear-gradient(to bottom,
      #f4c313fa 0%, #f4c313fa 100%, rgba(255, 183, 77, 0) 100%);
  box-sizing: content-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap:20rpx;
}

.title {

  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: baseline;
  gap: 20rpx;
}

.titleText {
  margin-top: 40rpx;
  font-size: 50rpx;
}
.Time{
  height:60rpx;
  width:700rpx;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: baseline;
}
.time{
  height: 100%;
  width:30%;
  border:1rpx solid #000000; 
  box-sizing:border-box;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.time.active {
  background-color: #222222dc; 
  color:#f4c313fa
}

.down {
  font-size: 35rpx;
}

.period-scroll{
  width: 100%;
  height: 100rpx;
  white-space: nowrap;
  background-color: #ffffff;
  border-bottom: 1rpx solid #dddddd;
  box-sizing: border-box;
}
.period-item{
  padding-left: 30rpx;
  position: relative;
  display: inline-flex;
  align-items: center;
  width:20%;
  height:100rpx;
  font-size: 35rpx;
  border-bottom: 1rpx solid #dddddd;
  box-sizing: border-box;
  color: #aaaaaa;
}
.period-item.selected {
  color: #222222;
  border-bottom: 10rpx solid #000000;
}

.chart-container {
  width: 100%;
  height: 420rpx;
  background-color: #ffffff;
}
.summary { display: flex; justify-content: space-between; gap: 24rpx; padding: 28rpx; background: #fff; }
.summary-value { display: block; margin-top: 12rpx; font-size: 38rpx; color: #5d4139; }
.ranking { margin-top: 20rpx; padding: 28rpx; background: #fff; padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }
.ranking-title { font-size: 32rpx; font-weight: bold; margin-bottom: 20rpx; }
.ranking-item { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 88rpx; border-bottom: 1rpx solid #eee; }
.ranking-amount { text-align: right; }
.percentage { display: inline-block; min-width: 100rpx; color: #71685f; }
.period-item { width: 150rpx; padding: 0 12rpx; justify-content: center; font-size: 28rpx; color: #71685f; }
.period-item.selected { border-bottom: 6rpx solid #b78b00; color: #5d4139; }
