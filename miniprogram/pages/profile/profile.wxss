.profile-header { background: #f4c313; padding: 0 32rpx 64rpx; border-radius: 0 0 40rpx 40rpx; }
.profile-identity { display: flex; align-items: center; gap: 28rpx; padding: 28rpx 12rpx; }
.profile-name { font-size: 38rpx; font-weight: 600; word-break: break-all; flex: 1; }
.profile-statistics { display: flex; gap: 16rpx; margin-top: 30rpx; }
.profile-stat { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 12rpx; color: #5d4139; font-size: 25rpx; }
.stat-number { color: #332d28; font-size: 46rpx; font-weight: 600; }
.profile-body { margin-top: -26rpx; }
.profile-menu-icon { width: 60rpx; height: 60rpx; flex-shrink: 0; }
