/* pages/detail/detail.wxss */
.top
{

  height: 350rpx;
  background-color: #fff;
  background-image:linear-gradient(to bottom,
  #f4c313fa 0%,#f4c313fa 70%,rgba(255, 183, 77, 0) 100%);
  box-sizing: content-box;
  display:flex;
  flex-direction: column;
  justify-content: center;
}

.title
{
  margin-top: 40rpx;
  font-size:50rpx;
  color:#5d4139;
  text-align:center;
}

.stats
{
  margin-top:20rpx;
  display:flex;
  justify-content: space-between;
  align-items:baseline;
  padding:0 30rpx;
}
.date2
{
  
  display: flex;
  flex-direction: row;
  align-items:flex-end;
}
.year
{
  font-size:35rpx;
  color:#5d4139;
}
.month
{
  margin-top:20rpx;
  font-size:70rpx;
}
.down
{

  padding-left:30rpx;
}
.statItem
{
  padding:0 50rpx;
  display:flex;
  flex-direction: column;
  align-items:flex-start;
  gap: 50rpx;

}

.stateLable
{
  font-size:35rpx;
  color:#5d4139;
}
.stateValue
{
  font-size:35rpx;
}
page {
  background-color: #ffffff;
}
.date {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.dateD{
  color:#6d6b6b
  
}
.dateE{
  margin-left: auto;
  color:#6d6b6b
}

.billgroup {
  padding: 16rpx 24rpx;
  flex-direction: column;
  display: flex;
}
.line{
  margin: 20rpx 30rpx 0;
  border-bottom: 2rpx solid #ccc;

}
.bill{
  min-height: 100rpx;
  display: flex;
  align-items: center;
  margin:10rpx;
  gap:10rpx;
}
.billList { padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }
.billText { flex: 1; min-width: 0; overflow-wrap: break-word; }
.billAmount { flex-shrink: 0; }
.billAmount{
  margin-left:auto;
}
.icon{
  height: 100rpx;
  width:100rpx;
  border-radius: 50%;       
  background: #edececf7;
}
